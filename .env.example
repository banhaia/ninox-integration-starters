# Copiá este archivo a .env solo si querés sobreescribir la configuración de la UI.
# Todo es OPCIONAL: la app arranca sin .env y el token se carga desde Configuración.

# Puerto del backend (el frontend de desarrollo corre en 5173 y proxya /api)
PORT=3030

# Directorio donde se guarda la base SQLite (ninox-app.db). Está en .gitignore.
DATA_DIR=./data

# Overrides de la integración Ninox. Si están definidos, tienen prioridad sobre la UI.
# NINOX_ENV=test            # test | prod | custom
# NINOX_BASE_URL=           # solo con NINOX_ENV=custom (por ejemplo una API local)
# NINOX_TOKEN=              # token X-NX-TOKEN. Nunca lo commitees.
# NINOX_TIMEOUT_MS=30000

# Intervalo de sync de catálogo en minutos (mínimo 10, lo exige Ninox)
# CATALOG_SYNC_MINUTES=15

# La app confía en los certificados raíz del sistema operativo además de los de Node, así
# una API local con certificado de desarrollo confiado (IIS Express, dotnet dev-certs) funciona.
# NINOX_USE_SYSTEM_CA=false   # para desactivarlo

# Último recurso, solo desarrollo local: desactiva TODA verificación TLS. Nunca en producción.
# NODE_TLS_REJECT_UNAUTHORIZED=0
